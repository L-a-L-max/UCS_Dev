<?xml version="1.0" encoding="UTF-8"?>
<!--
  T-52: 结构化日志配置 (JSON + MDC)

  双输出模式:
  - dev  环境: 控制台彩色人类可读格式 (便于调试)
  - prod 环境: JSON 格式 (便于 ELK/Loki 采集)

  MDC 自动注入字段:
  - traceId / spanId: 由 Micrometer Tracing (T-51) 自动设置
  - 自定义 MDC: userId, droneId (由业务代码手动 put)
-->
<configuration>

    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="ucs-backend"/>

    <!-- ========== dev 环境: 控制台彩色输出 ========== -->
    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%thread] [traceId=%X{traceId:-}] %cyan(%logger{36}) - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ========== prod 环境: JSON 结构化输出 ========== -->
    <springProfile name="prod">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"${APP_NAME}"}</customFields>
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>spanId</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>
                <includeMdcKeyName>droneId</includeMdcKeyName>
            </encoder>
        </appender>

        <!-- JSON 文件滚动输出 (供 Filebeat/Fluentd 采集) -->
        <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>/var/log/ucs/ucs-backend.json.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>/var/log/ucs/ucs-backend.%d{yyyy-MM-dd}.%i.json.log</fileNamePattern>
                <maxFileSize>100MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>5GB</totalSizeCap>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"${APP_NAME}"}</customFields>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
            <appender-ref ref="JSON_FILE"/>
        </root>
    </springProfile>

    <!-- 降低第三方库日志级别 -->
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.springframework.data.redis" level="WARN"/>
    <logger name="io.lettuce" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>

</configuration>
